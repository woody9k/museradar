# Waveshare ESP32-C6-Touch-LCD-1.47: ESP32-C6FH4/FH8 with 8 MB embedded flash
# and no PSRAM, a 1.47" 172x320 JD9853 LCD (SPI: SCLK 1, MOSI 2, MISO 3, CS 14,
# DC 15, RST 22, backlight 23), an AXS5106L touch controller (I2C: SDA 18,
# SCL 19, INT 21, RST 20), a QMI8658 IMU, a microSD slot (CS 4) and the BOOT
# button on GPIO 9. No status LED. Loaded after devices/sdkconfig.c6-nopsram,
# which has the C6's memory tuning.
#
# The screen isn't driven yet; status shows in the log. What the board does
# have is a Wi-Fi radar: motion and presence from CSI, as presence.read.
CONFIG_IDF_TARGET="esp32c6"
CONFIG_HOMEHUB_BUTTON_GPIO=9
CONFIG_HOMEHUB_LED_BACKEND_NONE=y
CONFIG_HOMEHUB_TUNNEL=n

CONFIG_ESP_WIFI_CSI_ENABLED=y
CONFIG_HOMEHUB_PRESENCE_CSI=y
